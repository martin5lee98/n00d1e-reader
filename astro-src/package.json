{
  "name": "yuelanshi",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 execute yuelanshi-articles --local --file=../schema.sql",
    "db:migrate:remote": "wrangler d1 execute yuelanshi-articles --remote --file=../schema.sql"
  },
  "dependencies": {
    "astro": "^7.3.4",
    "@astrojs/cloudflare": "^14.3.3"
  },
  "devDependencies": {
    "wrangler": "^4.125.0",
    "@cloudflare/workers-types": "^5.20260923.1",
    "typescript": "^5.0.0"
  }
}
