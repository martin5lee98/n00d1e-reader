---
// src/pages/latest.astro
//
// /latest: same ColumnBlock component as the homepage, but a single
// column of blocks ordered by which column updated most recently --
// matches latest-mockup.html's approved layout (single-col grid,
// cat-tag on each block header, "N 小时前更新" badge). Queries D1 via
// getLatestBlocks() (src/lib/db.ts).

import { env } from "cloudflare:workers";
import SiteLayout from "../layouts/SiteLayout.astro";
import ColumnBlock from "../components/ColumnBlock.astro";
import { getLatestBlocks } from "../lib/db";

// CORRECTED: see index.astro's detailed comment on why
// Astro.locals.runtime.env.DB (the old pattern) was replaced with a
// direct "cloudflare:workers" import.
const db = env.DB;

const blocks = await getLatestBlocks(db, 6);
---

<SiteLayout title="阅览室 — 最新" activeNav="latest">
  <div class="cat-section">
    <div class="block-grid single-col">
      {blocks.map((block) => (
        <ColumnBlock block={block} showCategoryTag={true} showUpdatedBadge={true} />
      ))}
    </div>

    {blocks.length === 0 && (
      <p style="color: #999; padding: 40px 0; text-align: center;">
        暂无内容 -- 尚未有任何栏目成功抓取过文章。
      </p>
    )}
  </div>
</SiteLayout>
