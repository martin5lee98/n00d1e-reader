---
// src/layouts/SiteLayout.astro
//
// Shared page chrome (topbar, logo, category nav, base typography) --
// a faithful port of homepage-mockup.html / latest-mockup.html's shared
// styling, not a redesign. Both index.astro and latest.astro use this
// so the chrome is defined once, matching the approved mockups exactly
// rather than duplicated (and potentially drifting) across pages.

const SITE_NAME = "N00dle";
const SITE_TAGLINE = "聚合有趣有深度的内容";
const DEFAULT_DESCRIPTION = "聚合有趣有深度的内容，按财经、科技、文化、社会、国际、生活分类";

import { ClientRouter } from "astro:transitions";
import { withRegion } from "../lib/region";

export interface Props {
  title: string;
  // Optional per-page <meta name="description">; falls back to the
  // site-wide default above.
  description?: string;
  activeNav: "home" | "finance" | "tech" | "culture" | "opinion" | "society" | "international" | "life" | "latest";
}

const { title, activeNav, description = DEFAULT_DESCRIPTION } = Astro.props;

// Region (?r=cn / ?r=hk) is carried along on every internal link.
const region = Astro.locals.regionParam;

// Tell search engines the r=… variants are the same page as the plain URL.
const canonicalUrl = new URL(Astro.url);
canonicalUrl.searchParams.delete("r");

const NAV_ITEMS: { key: Props["activeNav"]; label: string; href: string }[] = [
  { key: "home", label: "首页", href: "/" },
  { key: "finance", label: "财经", href: "/category/finance" },
  { key: "tech", label: "科技", href: "/category/tech" },
  { key: "culture", label: "文化", href: "/category/culture" },
  { key: "opinion", label: "评论", href: "/category/opinion" },
  { key: "society", label: "社会", href: "/category/society" },
  { key: "international", label: "国际", href: "/category/international" },
  { key: "life", label: "生活", href: "/category/life" },
  { key: "latest", label: "最新", href: "/latest" },
];

const today = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
  weekday: "long",
}).format(new Date());
---

<!DOCTYPE html>
<html lang="zh-Hans">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonicalUrl.toString()}>
  {/* App-like navigation: clicking an internal link swaps in the new
      page without a full reload (and starts loading it as soon as the
      link is hovered or touched). Pages are still rendered on the
      server, so caching and the ?r= region logic are unaffected. */}
  <ClientRouter />
  <meta property="og:site_name" content={SITE_NAME}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  {/* Google Analytics (GA4). Only on the deployed site, so visits while
      developing with `npm run dev` aren't counted. is:inline tells Astro
      to output these scripts exactly as written. */}
  {import.meta.env.PROD && (
    <>
      <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-5PV8MFXD7Y"></script>
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-5PV8MFXD7Y');
      </script>
    </>
  )}
</head>
<body>

<div class="topbar">
  <div class="topbar-inner">
    <a href={withRegion("/about", region)}>关于本站</a>
    <a href={withRegion("/rss", region)}>RSS 订阅</a>
    <div class="topbar-spacer"></div>
    <span>{today}</span>
  </div>
</div>

{/* Sticky: the site title stays at the top of the screen while the
    page scrolls; the category menu below it scrolls away. */}
<header class="site">
  <div class="logo-row">
    <h1><a href={withRegion("/", region)}>{SITE_NAME}</a></h1>
    <span class="tagline">{SITE_TAGLINE}</span>
  </div>
</header>

<div class="navbar">
  <div class="navbar-inner">
    <nav class="categories">
      <ul>
        {NAV_ITEMS.map((item) => (
          <li class={item.key === activeNav ? "active" : ""}>
            <a href={withRegion(item.href, region)}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</div>

<main>
  <slot />
</main>

<footer>
  Made with ❤️ for Mr. Pain
</footer>

<style is:global>
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: #ffffff;
    color: #222222;
    font-family: "Helvetica Neue", Arial, "PingFang SC", "Microsoft YaHei", sans-serif;
    font-size: 14px;
    line-height: 1.6;
    -webkit-text-size-adjust: 100%;
  }

  .topbar {
    background: #f6f6f6;
    border-bottom: 1px solid #d9d9d9;
  }
  .topbar-inner {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 16px;
    display: flex;
    align-items: center;
    height: 34px;
    font-size: 12.5px;
    color: #777;
  }
  .topbar-inner a { color: #777; text-decoration: none; margin-right: 14px; }
  .topbar-inner a:hover { text-decoration: underline; }
  .topbar-spacer { flex: 1; }

  header.site {
    position: sticky;
    top: 0;
    z-index: 20;
    background: #ffffff;
    border-bottom: 1px solid #ececec;
  }
  .logo-row {
    max-width: 1040px;
    margin: 0 auto;
    padding: 10px 16px 8px 16px;
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .logo-row h1 {
    font-size: 24px;
    font-weight: bold;
    margin: 0;
    color: #1a1a1a;
    font-family: Georgia, "Songti SC", serif;
  }
  .logo-row h1 a { color: inherit; text-decoration: none; }
  .logo-row .tagline {
    font-size: 13px;
    color: #999;
  }

  .navbar-inner {
    max-width: 1040px;
    margin: 0 auto;
    padding: 10px 16px 8px 16px;
  }

  nav.categories {
    position: relative; /* so the "keep active item in view" script measures from here */
    background: #eef3f9;
    border: 1px solid #c9d7e5;
    border-radius: 3px;
  }
  nav.categories ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
  }
  nav.categories li { border-right: 1px solid #c9d7e5; }
  nav.categories li:last-child { border-right: none; }
  nav.categories a {
    display: block;
    padding: 8px 16px;
    font-size: 14px;
    white-space: nowrap;
    font-weight: bold;
    color: #2255a4;
    text-decoration: none;
  }
  nav.categories a:hover { background: #dce8f5; text-decoration: underline; }
  nav.categories li.active a { background: #2255a4; color: #fff; }
  nav.categories li.active a:hover { text-decoration: none; }

  main {
    max-width: 1040px;
    margin: 0 auto;
    padding: 10px 16px 40px 16px;
  }

  .cat-section { margin-bottom: 8px; }
  .cat-section h2 {
    font-size: 17px;
    font-weight: bold;
    color: #1a1a1a;
    margin: 0 0 10px 0;
    padding-bottom: 5px;
    border-bottom: 2px solid #2255a4;
  }

  .block-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 24px;
  }
  .block-grid.single-col {
    grid-template-columns: 1fr;
    max-width: 640px;
  }

  footer {
    max-width: 1040px;
    margin: 0 auto;
    padding: 14px 16px 30px 16px;
    border-top: 1px solid #ddd;
    color: #999;
    font-size: 12px;
  }

  /* ---- Phones / narrow screens ---- */
  /* Layout only -- font sizes are the same as desktop. */
  @media (max-width: 720px) {
    .topbar-inner { padding: 0 12px; }
    .logo-row { padding: 9px 12px 7px 12px; }
    .navbar-inner { padding: 10px 12px 8px 12px; }
    main { padding: 6px 12px 32px 12px; }
    footer { padding: 14px 12px 28px 12px; }

    /* Keep the sticky title bar to one slim line: the tagline is cut
       with "…" if it doesn't fit beside the logo. */
    .logo-row .tagline { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
    .logo-row h1 { flex-shrink: 0; }

    /* Category menu: one line that scrolls sideways, instead of
       squeezing every item until the words stack vertically */
    nav.categories { overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
    nav.categories::-webkit-scrollbar { display: none; }
    nav.categories ul { width: max-content; }
    nav.categories a { padding: 9px 14px; }

    /* Column blocks stack in a single column */
    .block-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Runs on the first load and after every client-side page change.
  // On phones the menu scrolls sideways; make sure the current category
  // is visible instead of the menu jumping back to the start.
  document.addEventListener("astro:page-load", () => {
    const nav = document.querySelector<HTMLElement>("nav.categories");
    const active = nav?.querySelector<HTMLElement>("li.active");
    if (!nav || !active || nav.scrollWidth <= nav.clientWidth) return;
    nav.scrollLeft = active.offsetLeft - (nav.clientWidth - active.offsetWidth) / 2;
  });
</script>

</body>
</html>
